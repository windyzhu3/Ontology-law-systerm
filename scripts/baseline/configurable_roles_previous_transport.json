{
  "AppointmentV1": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "principal",
      "organization",
      "roleCode",
      "effectiveFrom",
      "effectiveUntil",
      "state",
      "etag"
    ],
    "properties": {
      "id": {
        "$ref": "#/components/schemas/Uuid"
      },
      "principal": {
        "$ref": "#/components/schemas/IdentityChoiceV1"
      },
      "organization": {
        "$ref": "#/components/schemas/IdentityChoiceV1"
      },
      "roleCode": {
        "type": "string",
        "enum": [
          "INTAKE_OPERATOR",
          "ROUTING_SUPERVISOR",
          "CONTACT_OPERATOR",
          "IDENTITY_ADMIN",
          "SALES_REPRESENTATIVE",
          "SALES_MANAGER",
          "FINANCE_OPERATOR",
          "CASE_ADMINISTRATOR"
        ]
      },
      "effectiveFrom": {
        "$ref": "#/components/schemas/Instant"
      },
      "effectiveUntil": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "state": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SUSPENDED",
          "ENDED"
        ]
      },
      "etag": {
        "$ref": "#/components/schemas/IdentityETag"
      }
    }
  },
  "IdentityAdminPageV1": {
    "type": "string",
    "enum": [
      "PRINCIPALS",
      "ORGANIZATIONS",
      "APPOINTMENTS",
      "AUTHORITY_GRANTS"
    ]
  },
  "IdentityChoiceV1": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label"
    ],
    "properties": {
      "id": {
        "$ref": "#/components/schemas/Uuid"
      },
      "label": {
        "$ref": "#/components/schemas/SafeText200"
      }
    }
  },
  "IdentityOptionKindV1": {
    "type": "string",
